# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Signing secrets — never commit
credentials.json
/credentials/
google-service-account.json
google-services.json
*.keystore

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — .env holds the Google Maps API key; never commit any of them
.env*

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local Expo modules (e.g. modules/lock-screen-call) still need their source
# committed, just not their own build output/gradle cache
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/

# Claude working notes (not for repo)
Claude_understand/

# Documentation and Guides (Private)
Guide/
*.md
*.txt
*.zip
*.bat
