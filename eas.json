{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.3:3000/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "http://192.168.1.3:3000",
        "EXPO_PUBLIC_OSRM_ADDIS_URL": "http://192.168.1.3:3000/osrm/addis",
        "EXPO_PUBLIC_OSRM_BAHIRDAR_URL": "http://192.168.1.3:3000/osrm/bahirdar"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://taxiapi.zmichael.click/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://taxiapi.zmichael.click",
        "EXPO_PUBLIC_OSRM_ADDIS_URL": "https://taxiapi.zmichael.click/osrm/addis",
        "EXPO_PUBLIC_OSRM_BAHIRDAR_URL": "https://taxiapi.zmichael.click/osrm/bahirdar"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://taxiapi.zmichael.click/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://taxiapi.zmichael.click",
        "EXPO_PUBLIC_OSRM_ADDIS_URL": "https://taxiapi.zmichael.click/osrm/addis",
        "EXPO_PUBLIC_OSRM_BAHIRDAR_URL": "https://taxiapi.zmichael.click/osrm/bahirdar"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json"
      }
    }
  }
}
