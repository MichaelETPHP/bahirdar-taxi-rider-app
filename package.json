{
  "name": "bahirdarride",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first expo start",
    "android": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first expo start --android",
    "ios": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first expo start --ios",
    "web": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first expo start --web",
    "ota:prod": "eas update --branch production --message \"$npm_config_msg\"",
    "ota:preview": "eas update --branch preview --message \"$npm_config_msg\"",
    "release:prod": "eas build --platform android --profile production --auto-submit",
    "build:preview": "eas build --platform android --profile preview"
  },
