# Android Google Maps key — app.config.js throws at config-resolution time if
# this is missing, from ANY process that evaluates the config (including the
# expo-updates Gradle task's own separate Node subprocess during a native
# build, which doesn't inherit env vars exported in a build shell — this
# .env.development file is the only thing every one of those reads).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyDqk1PB63xPc8inypQBY-XhMX6Z9moxg44

# Google Sign-In — Web Client ID from Google Cloud Console (bahirdar-play
# project, OAuth client type "Web application"). Empty until Step 1 is done;
# the button shows a "not configured yet" alert until this is filled in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=872882912380-bbj4kv3s67egf1ut9jj4j4g1b7acle5l.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=872882912380-f4bhhp9eqb4gi53dh38p9tb5ij4enacq.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=AIzaSyD98rjvovnbS20hL3yZw7fF1B-iA3SSEmY

