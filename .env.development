# # Local dev — used by `expo start` only (ignored by EAS builds)
# Mixed setup: API + OSRM on the live server (stable, always up), Socket on
# the local dev server (192.168.8.196) so realtime/socket code changes can be
# iterated on without redeploying. Works because local bahirdar-api shares the
# same DB and JWT signing keys as production — see conversation notes.
EXPO_PUBLIC_API_URL=http://192.168.1.9:3000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.9:3000
EXPO_PUBLIC_OSRM_ADDIS_URL=https://taxiapi.zmichael.click/osrm/addis
EXPO_PUBLIC_OSRM_BAHIRDAR_URL=https://taxiapi.zmichael.click/osrm/bahirdar

# Google Sign-In — Web Client ID from Google Cloud Console (bahirdar-play
# project, OAuth client type "Web application"). Empty until Step 1 is done;
# the button shows a "not configured yet" alert until this is filled in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=872882912380-bbj4kv3s67egf1ut9jj4j4g1b7acle5l.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=872882912380-f4bhhp9eqb4gi53dh38p9tb5ij4enacq.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=AIzaSyD98rjvovnbS20hL3yZw7fF1B-iA3SSEmY

# Stripe (diaspora wallet top-up — sandbox/test mode)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51U4FRHCFwjw4di9Xj9LsK2Bf7Dqm730ysq6FIiDVYGy7LLbQhiCeGt6S8to1FYPbMgfKHsds07JkuIBUVtgqqJ5h00u3UFjdmq

